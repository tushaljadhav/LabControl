# LabControl Agent Configuration
# ================================

# Shared Fernet Security Key (MUST match the server's key)
# Generate a new key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LABCONTROL_SECRET_KEY=mRBEOUI43W4N2BWOjGPhT46c-GR6QC5MZRcVXVipnwc=

# Auto-Discovery: LabControl Server URL (Admin PC's IP and port)
# The agent will send its IP, MAC, and hostname to the server every 30 seconds.
# This enables automatic IP updates when DHCP changes the IP address!
# Example: LABCONTROL_SERVER_URL=http://192.168.1.143:8080
LABCONTROL_SERVER_URL=http://192.168.1.143:8080
